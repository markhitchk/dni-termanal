# DNI database backup configuration.
# Copy to /etc/dni-terminal/backup.env with owner root:root and mode 0600.
# The setup helper deploy/backup/configure-backups.sh does this interactively.

DNI_APP_DIR=/opt/dni-terminal

# MUST be a separate PRIVATE repository. Never use markhitchk/dni-termanal;
# the source repository is public and database material must not be stored there.
DNI_BACKUP_REPOSITORY=markhitchk/dni-termanal-backups
DNI_BACKUP_BRANCH=database-backups
DNI_BACKUP_RETENTION=14

# Use a fine-grained PAT limited to the private backup repository with
# repository Contents read/write. Never commit the real token.
DNI_BACKUP_GITHUB_TOKEN=SET_ON_VPS_ONLY

# Used to encrypt every database payload before it leaves the VPS.
# Keep a copy OFF the VPS so backups remain recoverable if the VPS is lost.
DNI_BACKUP_ENCRYPTION_KEY=SET_ON_VPS_ONLY
