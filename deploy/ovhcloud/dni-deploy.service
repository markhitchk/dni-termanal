[Unit]
Description=Dreadnought Imperium DNI Automatic Deploy Endpoint
After=network-online.target dni-terminal.service
Wants=network-online.target

[Service]
Type=simple
User=dni
Group=dni
WorkingDirectory=/opt/dni-terminal
EnvironmentFile=/etc/dni-terminal/dni.env
ExecStart=/usr/bin/node /opt/dni-terminal/server/dni-deploy.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/dni-terminal

[Install]
WantedBy=multi-user.target
