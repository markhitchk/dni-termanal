# DNI Terminal OVHcloud VPS runtime
DNI_HOST=127.0.0.1
DNI_PORT=8080
DNI_NODE_NAME=OVH-DNI-01
DNI_VERSION=4.2.0-vps

# Required for command/admin mutations. Generate a long random value on the VPS.
DNI_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Tokenless deployment: the VPS polls origin/main and deploys verified changes itself.
DNI_AUTO_SYNC=true
DNI_AUTO_SYNC_INTERVAL_SECONDS=60

# Star Comms is bridged by the VPS. Never put the owner key in public frontend files.
STAR_COMMS_SHARD_URL=https://s-dreadnought-imperium.star-comms.org
STAR_COMMS_OWNER_KEY=CHANGE_ME_ON_THE_VPS_ONLY

# Optional persistent state override.
# DNI_STATE_FILE=/var/lib/dni-terminal/dni-network.json
