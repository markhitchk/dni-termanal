# DNI Terminal OVHcloud VPS runtime
DNI_HOST=127.0.0.1
DNI_PORT=8080
DNI_NODE_NAME=OVH-DNI-01
DNI_VERSION=4.2.0-vps

# Legacy Node command token. The PHP production account system uses Discord OAuth
# and database-backed permissions instead of this token.
DNI_ADMIN_TOKEN=SET_ON_VPS_ONLY

# Automatic /deploy.php behavior. No deployment token is required.
DNI_DEPLOY_MIN_INTERVAL_MS=15000

# Optional MariaDB connection. The production site now has a shell-free embedded
# server database at data/dni-embedded.json, so these values are not required for
# Dashboard, Services, Sectors, user records, or the DNI Admin editor.
DNI_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=dni_terminal;charset=utf8mb4
DNI_DB_USER=
DNI_DB_PASSWORD=

# Discord OAuth account system.
# Public application/client ID requested for DNI login.
DNI_DISCORD_CLIENT_ID=1542715169975836682
DNI_DISCORD_REDIRECT_URI=https://www.dreadnoughtimperium.org/auth/discord/callback
# Requested scopes: identify guilds guilds.members.read
# Leave the client secret empty only when the Discord application has Public Client
# enabled; DNI will use PKCE automatically. Otherwise set the secret server-side.
DNI_DISCORD_CLIENT_SECRET=
# Optional: set a guild ID to enforce membership and synchronize member roles.
DNI_DISCORD_GUILD_ID=

# Optional initial command administrator. Set this to the trusted Discord numeric
# user ID that should receive the built-in DNI Admin permission after sign-in.
DNI_BOOTSTRAP_ADMIN_DISCORD_ID=

# Star Comms is bridged by the VPS. Never put the owner key in public frontend files.
STAR_COMMS_SHARD_URL=https://s-dreadnought-imperium.star-comms.org
STAR_COMMS_OWNER_KEY=SET_ON_VPS_ONLY

# Legacy Node JSON persistence override.
# DNI_STATE_FILE=/var/lib/dni-terminal/dni-network.json
