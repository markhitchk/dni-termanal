server {
    listen 80;
    listen [::]:80;
    server_name dreadnoughtimperium.org www.dreadnoughtimperium.org;

    # Automatic deployment endpoint. This route is intentionally limited to the
    # fixed DNI deploy service on localhost; it cannot select arbitrary refs or
    # execute user-supplied commands.
    location = /deploy.php {
        proxy_pass http://127.0.0.1:8081/deploy.php;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 65s;
    }

    location = /api/dni/health {
        proxy_pass http://127.0.0.1:8080/api/dni/health;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
}
