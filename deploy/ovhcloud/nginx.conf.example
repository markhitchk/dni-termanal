server {
    listen 80;
    listen [::]:80;
    server_name dreadnoughtimperium.org www.dreadnoughtimperium.org;

    # Secure deployment trigger. The token may be sent as a Bearer header by
    # GitHub Actions, or as ?token=... for a manual browser-triggered sync.
    # Access logging is disabled here so query-string tokens are not written to
    # the Nginx access log.
    location = /deploy.php {
        proxy_pass http://127.0.0.1:8081/deploy.php$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        access_log off;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 65s;
    }

    location = /api/dni/health {
        proxy_pass http://127.0.0.1:8080/api/dni/health;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }
}
