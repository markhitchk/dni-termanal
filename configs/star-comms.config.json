{
  "provider": "Star Comms",
  "mode": "OVHcloud VPS server-managed bridge",
  "launchHost": "https://star-comms.org/launch",
  "shardUrl": "https://s-dreadnought-imperium.star-comms.org",
  "apiBase": "/api/dni/comms",
  "upstreamApiBase": "https://s-dreadnought-imperium.star-comms.org/api/v1",
  "ownerApiKeyEnvironmentVariable": "STAR_COMMS_OWNER_KEY",
  "shardEnvironmentVariable": "STAR_COMMS_SHARD_URL",
  "secrets": {
    "commitLaunchToken": false,
    "commitOwnerApiKey": false,
    "browserOwnerKeyStorage": false,
    "storage": "OVHcloud VPS environment only"
  },
  "runtime": {
    "frontend": "served by DNI VPS",
    "backend": "served by DNI VPS",
    "health": "/api/dni/health",
    "commsConfig": "/api/dni/comms/config"
  }
}
